{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SrudAgent",
  "version": "0.1.0",
  "identifier": "com.srudagent.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SrudAgent",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "icon": ["icons/icon.png"],
    "active": true,
    "targets": "all"
  }
}
